# PLANTILLA DENGUEVERSE · inst/CITATION
# Toma nombre, título, versión y año del DESCRIPTION; no hay que editar nada
# salvo, opcionalmente, agregar el artículo que describe el paquete (abajo).

pkg     <- meta$Package
year    <- if (!is.null(meta$`Date/Publication`)) substr(meta$`Date/Publication`, 1, 4) else format(Sys.Date(), "%Y")
authors <- eval(parse(text = meta$`Authors@R`))
authors <- authors[vapply(authors, function(p) any(p$role %in% c("aut", "cre")), logical(1))]

bibentry(
    bibtype = "Manual",
    title   = paste0(pkg, ": ", meta$Title),
    author  = authors,
    year    = year,
    note    = paste("R package version", meta$Version),
    url     = paste0("https://fdzul.r-universe.dev/", pkg),
    textVersion = paste0(
        paste(vapply(authors, function(p) paste(p$family, substr(p$given, 1, 1)), ""), collapse = ", "),
        " (", year, "). ", pkg, ": ", meta$Title, ". R package version ", meta$Version,
        ". https://fdzul.r-universe.dev/", pkg
    )
)

